# Reverse Image Search APIs
# Pexels is recommended (free tier, simple setup)
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here
BING_SEARCH_KEY=your_bing_search_api_key_here

# Ethereum Blockchain (Sepolia testnet — Goerli is deprecated/dead)
# Get a free Infura key at https://infura.io then use the Sepolia endpoint:
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/your_infura_key_here
# Wallet private key (with or without 0x). Use a THROWAWAY test wallet, never a real one.
ETHEREUM_PRIVATE_KEY=your_private_key_here
ETHEREUM_NETWORK=sepolia
# Filled in automatically after you run: python contract/deploy.py
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Face Detection
MIN_FACE_SIZE=20
FACE_CONFIDENCE_THRESHOLD=0.6

# Image Search
IMAGE_SEARCH_TIMEOUT=30
MAX_SEARCH_RESULTS=10
SIMILARITY_THRESHOLD=0.85

# Logging
LOG_LEVEL=INFO
